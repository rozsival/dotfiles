dot_brew_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      dot_brew_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  action="brew"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --mas)

      for conflict in --check --cleanup; do
        if [[ -n "${args[$conflict]:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "$conflict" >&2
          exit 1
        fi
      done

      args['--mas']=1
      shift
      ;;

    --check)

      for conflict in --mas --cleanup; do
        if [[ -n "${args[$conflict]:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "$conflict" >&2
          exit 1
        fi
      done

      args['--check']=1
      shift
      ;;

    --cleanup)

      for conflict in --mas --check; do
        if [[ -n "${args[$conflict]:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "$conflict" >&2
          exit 1
        fi
      done

      args['--cleanup']=1
      shift
      ;;

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      printf "invalid argument: %s\n" "$key" >&2
      exit 1

      ;;

    esac
  done

}

