dot_vault_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      dot_vault_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  missing_deps=

  if ! command -v op >/dev/null 2>&1; then
    printf "missing dependency: op\n" >&2
    printf "%s\n\n" "1Password CLI: dot brew" >&2
    missing_deps=1
  fi

  if [[ -n $missing_deps ]]; then
    exit 1
  fi

  action=${1:-}

  case $action in

  status)
    action="status"
    shift
    dot_vault_status_parse_requirements "$@"
    shift $#
    ;;

  pull)
    action="pull"
    shift
    dot_vault_pull_parse_requirements "$@"
    shift $#
    ;;

  push)
    action="push"
    shift
    dot_vault_push_parse_requirements "$@"
    shift $#
    ;;

  *)
    action="status"
    dot_vault_status_parse_requirements "$@"
    shift $#
    ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      printf "invalid argument: %s\n" "$key" >&2
      exit 1

      ;;

    esac
  done

}

dot_vault_status_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      dot_vault_status_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  action="vault status"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        escaped="$(printf '%q' "$1")"
        if [[ -z ${args['title']+x} ]]; then
          args['title']="$escaped"
        else
          args['title']="${args['title']} $escaped"

        fi
        shift

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      escaped="$(printf '%q' "$1")"
      if [[ -z ${args['title']+x} ]]; then
        args['title']="$escaped"
      else
        args['title']="${args['title']} $escaped"

      fi
      shift

      ;;

    esac
  done

}

