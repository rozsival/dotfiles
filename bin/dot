dot_agent_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
    --help | -h)
      long_usage=yes
      dot_agent_usage
      exit
      ;;

    *)
      break
      ;;

    esac
  done

  action="agent"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    --)
      shift
      while [[ $# -gt 0 ]]; do
        key="$1"

        if [[ -z ${args['harness']+x} ]]; then
          args['harness']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

      done
      break
      ;;

    -?*)
      printf "invalid option: %s\n" "$key" >&2
      exit 1
      ;;

    *)

      if [[ -z ${args['harness']+x} ]]; then
        args['harness']=$1
        shift
      else
        printf "invalid argument: %s\n" "$key" >&2
        exit 1
      fi

      ;;

    esac
  done

  [[ -n ${args['harness']:-} ]] || args['harness']="omp"

  if [[ -n ${args['harness']:-} ]] && [[ ! ${args['harness']:-} =~ ^(omp|claude)$ ]]; then
    printf "%s\n" "harness must be one of: omp, claude" >&2
    exit 1
  fi

}

