completion_run() {
  local -a completion_words=("$@")
  local -A completion_blocked_flags=()
  local -A completion_emitted=()
  local -a completion_options=()
  local -A completion_options_seen=()
  local completion_count=${#completion_words[@]}
  local completion_current=""

  if [[ $completion_count -gt 0 ]]; then
    completion_current="${completion_words[$((completion_count - 1))]}"
    unset 'completion_words[completion_count - 1]'
  fi

  dot_completion "$completion_current" "${completion_words[@]}"

  local completion_options_string=""
  if [[ ${#completion_options[@]} -gt 0 ]]; then
    completion_options_string="$(
      IFS=,
      printf '%s' "${completion_options[*]}"
    )"
  fi
  printf ':options=%s\n' "$completion_options_string"
}

completion_candidates() {
  local completion_current="$1"
  shift

  local completion_candidate
  for completion_candidate in "$@"; do
    if [[ $completion_candidate == "$completion_current"* ]] &&
      [[ -z "${completion_emitted[$completion_candidate]:-}" ]]; then
      printf '%s\n' "$completion_candidate"
      completion_emitted["$completion_candidate"]=1
    fi
  done
}

completion_flag_candidates() {
  local completion_flag="$1"
  local completion_current="$2"
  shift 2

  if [[ -z "${completion_blocked_flags[$completion_flag]:-}" ]]; then
    completion_candidates "$completion_current" "$@"
  fi
}

completion_add_options() {
  local completion_option
  for completion_option in "$@"; do
    if [[ -z "${completion_options_seen[$completion_option]:-}" ]]; then
      completion_options+=("$completion_option")
      completion_options_seen["$completion_option"]=1
    fi
  done
}

completion_dynamic_candidates() {
  local completion_current="$1"
  local completion_output="$2"

  [[ -n $completion_output ]] || return

  local completion_candidate
  while IFS= read -r completion_candidate; do
    if [[ -n $completion_candidate ]]; then
      completion_candidates "$completion_current" "$completion_candidate"
    fi
  done <<<"$completion_output"
}

send_completions() {
  local completion_shell="${1:-bash}"

  case "$completion_shell" in
  bash) send_completions_bash ;;
  *)
    printf 'unsupported shell: %s\n' "$completion_shell" >&2
    return 1
    ;;
  esac
}

send_completions_bash() {
  echo $'_dot_completions() {'
  echo $'  local completion_command="${COMP_WORDS[0]}"'
  echo $'  local completion_current="${COMP_WORDS[COMP_CWORD]:-}"'
  echo $'  local completion_word_count=$((COMP_CWORD - 1))'
  echo $'  local -a completion_words=()'
  echo $'  local -a completion_response=()'
  echo $'  local -a completion_options=()'
  echo $'  local -A completion_seen=()'
  echo $''
  echo $'  if [[ $completion_word_count -gt 0 ]]; then'
  echo $'    completion_words=("${COMP_WORDS[@]:1:completion_word_count}")'
  echo $'  fi'
  echo $''
  echo $'  COMPREPLY=()'
  echo $'  while IFS= read -r completion_line; do'
  echo $'    completion_response+=("$completion_line")'
  echo $'  done < <("$completion_command" __complete "${completion_words[@]}" "$completion_current")'
  echo $''
  echo $'  local completion_directive="${completion_response[-1]:-}"'
  echo $'  if [[ $completion_directive == :options=* ]]; then'
  echo $'    unset "completion_response[-1]"'
  echo $'    IFS=, read -r -a completion_options <<< "${completion_directive#:options=}"'
  echo $'  fi'
  echo $''
  echo $'  COMPREPLY=("${completion_response[@]}")'
  echo $'  local completion_candidate'
  echo $'  for completion_candidate in "${COMPREPLY[@]}"; do'
  echo $'    completion_seen["$completion_candidate"]=1'
  echo $'  done'
  echo $''
  echo $'  local completion_option'
  echo $'  local completion_files=false'
  echo $'  local completion_directories=false'
  echo $'  for completion_option in "${completion_options[@]}"; do'
  echo $'    case "$completion_option" in'
  echo $'      files) completion_files=true ;;'
  echo $'      directories) completion_directories=true ;;'
  echo $'      no-space) compopt -o nospace ;;'
  echo $'    esac'
  echo $'  done'
  echo $''
  echo $'  if [[ $completion_files == true ]]; then'
  echo $'    while IFS= read -r completion_candidate; do'
  echo $'      if [[ -z "${completion_seen[$completion_candidate]:-}" ]]; then'
  echo $'        COMPREPLY+=("$completion_candidate")'
  echo $'        completion_seen["$completion_candidate"]=1'
  echo $'      fi'
  echo $'    done < <(compgen -f -- "$completion_current")'
  echo $'  elif [[ $completion_directories == true ]]; then'
  echo $'    while IFS= read -r completion_candidate; do'
  echo $'      if [[ -z "${completion_seen[$completion_candidate]:-}" ]]; then'
  echo $'        COMPREPLY+=("$completion_candidate")'
  echo $'        completion_seen["$completion_candidate"]=1'
  echo $'      fi'
  echo $'    done < <(compgen -d -- "$completion_current")'
  echo $'  fi'
  echo $'}'
  echo $''
  echo $'complete -F _dot_completions dot'
}

dot_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    setup)
      shift
      dot_setup_completion "$completion_current" "$@"
      return
      ;;
    agent)
      shift
      dot_agent_completion "$completion_current" "$@"
      return
      ;;
    doctor)
      shift
      dot_doctor_completion "$completion_current" "$@"
      return
      ;;
    sync)
      shift
      dot_sync_completion "$completion_current" "$@"
      return
      ;;
    update)
      shift
      dot_update_completion "$completion_current" "$@"
      return
      ;;
    link)
      shift
      dot_link_completion "$completion_current" "$@"
      return
      ;;
    brew)
      shift
      dot_brew_completion "$completion_current" "$@"
      return
      ;;
    macos)
      shift
      dot_macos_completion "$completion_current" "$@"
      return
      ;;
    identities)
      shift
      dot_identities_completion "$completion_current" "$@"
      return
      ;;
    vault)
      shift
      dot_vault_completion "$completion_current" "$@"
      return
      ;;
    help)
      shift
      dot_help_completion "$completion_current" "$@"
      return
      ;;
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --version | -v)
      completion_blocked_flags["--version"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done
  completion_candidates "$completion_current" setup agent doctor sync update link brew macos identities vault help

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --version "$completion_current" --version -v
  fi

}

dot_setup_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_agent_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      local -a completion_values=(
        "omp"
        "claude"
      )
      completion_candidates "$completion_current" "${completion_values[@]}"
      ;;
    esac
  fi

}

dot_doctor_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_sync_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_update_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_link_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --dry-run | -n)
      completion_blocked_flags["--dry-run"]=1

      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --dry-run "$completion_current" --dry-run -n
  fi

}

dot_brew_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --mas)
      completion_blocked_flags["--mas"]=1
      completion_blocked_flags["--check"]=1
      completion_blocked_flags["--cleanup"]=1

      shift
      ;;
    --check)
      completion_blocked_flags["--check"]=1
      completion_blocked_flags["--mas"]=1
      completion_blocked_flags["--cleanup"]=1

      shift
      ;;
    --cleanup)
      completion_blocked_flags["--cleanup"]=1
      completion_blocked_flags["--mas"]=1
      completion_blocked_flags["--check"]=1

      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --mas "$completion_current" --mas
    completion_flag_candidates --check "$completion_current" --check
    completion_flag_candidates --cleanup "$completion_current" --cleanup
  fi

}

dot_macos_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --check)
      completion_blocked_flags["--check"]=1

      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --check "$completion_current" --check
  fi

}

dot_identities_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --check)
      completion_blocked_flags["--check"]=1

      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --check "$completion_current" --check
  fi

}

dot_vault_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    status)
      shift
      dot_vault_status_completion "$completion_current" "$@"
      return
      ;;
    pull)
      shift
      dot_vault_pull_completion "$completion_current" "$@"
      return
      ;;
    push)
      shift
      dot_vault_push_completion "$completion_current" "$@"
      return
      ;;
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      dot_vault_status_completion "$completion_current" "$@"
      return
      ;;
    esac
  done
  completion_candidates "$completion_current" status pull push

  dot_vault_status_completion "$completion_current"
  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_vault_status_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -lt 0 ]]; then
        completion_arg_index=$((completion_arg_index + 1))
      fi
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      if completion_output="$({ vault_titles; } 2>/dev/null)"; then
        completion_dynamic_candidates "$completion_current" "$completion_output"
      fi
      ;;
    esac
  fi

}

dot_vault_pull_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    --force | -f)
      completion_blocked_flags["--force"]=1

      shift
      ;;
    *)
      if [[ $completion_arg_index -lt 0 ]]; then
        completion_arg_index=$((completion_arg_index + 1))
      fi
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --force "$completion_current" --force -f
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      if completion_output="$({ vault_titles; } 2>/dev/null)"; then
        completion_dynamic_candidates "$completion_current" "$completion_output"
      fi
      ;;
    esac
  fi

}

dot_vault_push_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -lt 0 ]]; then
        completion_arg_index=$((completion_arg_index + 1))
      fi
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
    0)
      if completion_output="$({ vault_titles; } 2>/dev/null)"; then
        completion_dynamic_candidates "$completion_current" "$completion_output"
      fi
      ;;
    esac
  fi

}

dot_help_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      if [[ $completion_arg_index -ge 1 ]]; then
        return
      fi
      completion_arg_index=$((completion_arg_index + 1))
      shift

      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

dot_completions_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
      completion_blocked_flags["--help"]=1
      shift
      ;;
    *)
      return
      ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

initialize() {
  declare -g version=""
  set -euo pipefail

  export DOT_OP_ACCOUNT="${DOT_OP_ACCOUNT:-my.1password.com}"
  export DOT_OP_VAULT="${DOT_OP_VAULT:-Workstation}"
  export DEVBOX_DIR="${DEVBOX_DIR:-$HOME/projects/rozsival/devbox}"

  DOTFILES="$(dotfiles_root)"
  # bashly's `dot --version` prints this: the commit this checkout is at.
  version="$(git -C "$DOTFILES" log -1 --format='%h (%cs)' 2>/dev/null || true)"
  HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
  # Homebrew 7 asks before installing by default; `dot` runs unattended and from agents.
  export HOMEBREW_NO_ASK=1
  # Homebrew retries a refused cask step (macOS App Management) under sudo; without
  # a terminal, as in an agent's shell, that waits on a Touch ID prompt no one sees.
  # Fail instead: the app in /Applications stays untouched and unadopted until
  # `dot brew` runs in a terminal. Safe because no Brewfile cask ships two apps -
  # one that did could lose its first, already adopted app in Homebrew's rollback.
  [ -t 0 ] || export HOMEBREW_NO_SUDO=1
  DEVBOX_REPO=https://github.com/rozsival/devbox.git
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
  CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  IDENTITIES_LIB="$HOME/.local/libexec/devbox-identities"
  OP_AGENT_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  OP_SSH_SIGN=/Applications/1Password.app/Contents/MacOS/op-ssh-sign
  # Same pins as devbox's container/skills.sh, so laptop and devbox agents match.
  SKILLS_CLI_VERSION=1.5.26
  AGENT_BROWSER_VERSION=0.37.1
  SKILLS="vercel-labs/agent-browser:agent-browser anthropics/skills:skill-creator vercel-labs/skills:find-skills herdrdev/herdr:herdr max-sixty/worktrunk:worktrunk"
  GCLOUD_COMPONENTS='gke-gcloud-auth-plugin alpha beta cloud-sql-proxy'

  if [ -t 1 ]; then
    B=$'\033[1m' RED=$'\033[31m' GRN=$'\033[32m' YEL=$'\033[33m' DIM=$'\033[2m' RST=$'\033[0m'
  else
    B='' RED='' GRN='' YEL='' DIM='' RST=''
  fi
  FAILS=0
  WARNS=0

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
  "setup") dot_setup_command ;;
  "agent") dot_agent_command ;;
  "doctor") dot_doctor_command ;;
  "sync") dot_sync_command ;;
  "update") dot_update_command ;;
  "link") dot_link_command ;;
  "brew") dot_brew_command ;;
  "macos") dot_macos_command ;;
  "identities") dot_identities_command ;;
  "vault") dot_vault_command ;;
  "vault status") dot_vault_status_command ;;
  "vault pull") dot_vault_pull_command ;;
  "vault push") dot_vault_push_command ;;
  "help") dot_help_command ;;
  "completions") dot_completions_command ;;
  esac
}

start() {
  if [[ ${1:-} == "__complete" ]]; then
    completion_run "${@:2}"
    return
  fi

  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
