dot_usage() {
  if [[ -n $long_usage ]]; then
    printf "dot\n\n"
    printf "  Takes this Mac from a fresh install to \`dot doctor\` passing.\n  Run \`dot setup\`, then \`dot agent\` for the guided rest; \`dot doctor\` tells you\n  what is left.\n\n"
  else
    printf "dot - Takes this Mac from a fresh install to \`dot doctor\` passing.\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  dot COMMAND\n"
  printf "  dot [COMMAND] --help | -h\n"
  printf "  dot --version | -v\n"
  echo

  printf "%s\n" "Setup Commands:"
  printf "  %s   Everything automatable; idempotent.\n" "setup      "
  printf "  %s   Continue the guided setup in an agent harness.\n" "agent      "
  printf "  %s   Acceptance test for the whole machine.\n" "doctor     "
  echo
  printf "%s\n" "Maintenance Commands:"
  printf "  %s   Bring this Mac up to what origin has.\n" "sync       "
  printf "  %s   Upgrade everything installed.\n" "update     "
  echo
  printf "%s\n" "Parts Commands:"
  printf "  %s   Symlink home/ into ~ and copy seed/ where absent.\n" "link       "
  printf "  %s   Install what the Brewfile declares.\n" "brew       "
  printf "  %s   Apply the macOS defaults in macos/defaults.sh.\n" "macos      "
  printf "  %s   Render git and SSH identity config.\n" "identities "
  printf "  %s   Sync vault.list files with 1Password Documents.\n" "vault      "
  echo
  printf "%s\n" "Commands:"
  printf "  %s   Show help about a command.\n" "help       "
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

    printf "%s\n" "Environment Variables:"

    printf "  %s\n" "DOT_OP_ACCOUNT"
    printf "    1Password account for \`dot vault\` and \`dot doctor\`\n"
    printf "    %s\n" "Default: my.1password.com"
    echo

    printf "  %s\n" "DOT_OP_VAULT"
    printf "    1Password vault holding the vault.list Documents\n"
    printf "    %s\n" "Default: Workstation"
