    printf "  %s\n" "DEVBOX_DIR"
    printf "    Clone of the devbox repo\n"
    printf "    %s\n" "Default: $HOME/projects/rozsival/devbox"
    echo

    printf "Fresh Mac: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/rozsival/dotfiles/main/install.sh)\"\n"
    echo

  fi
}

