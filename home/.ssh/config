# No private keys on this disk: every key is a 1Password item served by its
# agent. The *.pub files beside this one only select which agent key a host gets
# (IdentityFile <pub> + IdentitiesOnly), mirroring the devbox layout.

# GitHub Host/Match blocks, rendered by `dot identities` from
# ~/.config/devbox/identities.conf (devbox-identities render ssh-config).
# Absent until then; a glob that matches nothing is not an error.
Include ~/.ssh/config.d/*

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	AddKeysToAgent no
	ServerAliveInterval 30

# Panther Minor workstation (Tailnet only, sshd on 2222)
Host panther-minor
	HostName panther-minor
	Port 2222
	User vit
	IdentitiesOnly yes
	IdentityFile ~/.ssh/id_personal.pub
	ForwardAgent no

# Panther Minor controller (Pi Zero, Tailnet only, sshd on 2222)
Host pi-zero
	HostName pi-zero
	Port 2222
	User vit
	IdentitiesOnly yes
	IdentityFile ~/.ssh/id_personal.pub
	ForwardAgent no

# Containerised devbox on panther-minor, published on its Tailscale IP only.
# ForwardAgent stays off: manual git as yourself inside the devbox is an
# explicit `ssh -A devbox`, never something herdr's connection carries.
Host devbox
	HostName panther-minor
	Port 2223
	User dev
	IdentitiesOnly yes
	IdentityFile ~/.ssh/devbox.pub
	ForwardAgent no
