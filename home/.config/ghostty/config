# Ghostty only hosts herdr here; keep it plain. Reference: `ghostty +show-config --default --docs`.

font-size = 13

# Left Option is Alt for TUIs (herdr, OMP, readline word motions); right Option
# still types accented characters.
macos-option-as-alt = left

window-save-state = always

# `ssh` from a Ghostty shell sends TERM=xterm-256color, never xterm-ghostty:
# every host knows it, as root and under sudo too. ssh-terminfo is deliberately
# off: it installs xterm-ghostty into the remote user's ~/.terminfo only, which
# root, sudo and setcap binaries never read, and caches the host as done
# (~/.local/state/ghostty/ssh_cache) so a reflashed box gets the TERM without
# the terminfo - "Error opening terminal: xterm-ghostty". herdr panes already
# run xterm-256color, so nothing changes there; COLORTERM keeps truecolor.
#
# Locally xterm-ghostty lives only in Ghostty.app's terminfo, which the shell
# finds via TERMINFO. sudo's env_reset drops it and neither /usr/share/terminfo
# nor Homebrew's ncurses ships the entry, so `sudo nano` dies with "cannot
# initialize terminal type". `sudo` wraps sudo as `sudo --preserve-env=TERMINFO`
# (a shell function: covers sudo typed in a Ghostty shell, not scripts).
shell-integration-features = ssh-env,sudo
